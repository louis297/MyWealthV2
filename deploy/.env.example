# Template for /opt/mywealth/.env on the VPS (docs/deployment.md §5, §6).
# Copy to .env, fill in, `chmod 600 .env`. Keep a copy in the owner's password manager.
# Values: letters, digits and `-` only, except LUCKYPENNY_LICENSE_KEY (pasted as issued). `$` triggers
# compose interpolation; quotes or `;` break the SQL connection string. GitHub does not hold these values.

# --- Written by deploy.sh. Leave empty on the first start. ---
# Image tag (commit SHA) currently deployed.
IMAGE_TAG=
# Image tag deployed before IMAGE_TAG; used by rollback.sh.
PREVIOUS_IMAGE_TAG=

# --- Server ---
# GitHub owner of the GHCR images, lower case (ghcr.io/<owner>/mywealth-*).
GHCR_OWNER=
# Showcase domain. Hostnames: id., adviser., customer., admin., sim.<DOMAIN>.
DOMAIN=
# Contact email for the ACME account.
ACME_EMAIL=
# Empty for the production ACME issuer. For a first start set it to
# https://acme-staging-v02.api.letsencrypt.org/directory (§12 step 10).
ACME_CA=

# --- Secrets ---
# SQL Server sa password. SQL Server requires 8+ characters with upper case, lower case and digits.
SQL_SA_PASSWORD=
# OIDC client secrets. Each is shared by identity and the matching client host.
ADVISER_PORTAL_CLIENT_SECRET=
CUSTOMER_PORTAL_CLIENT_SECRET=
BACK_OFFICE_CLIENT_SECRET=
# Fourth OIDC client (identity and the simulator). Required by identity even while the simulator is off.
SIMULATOR_CLIENT_SECRET=
# Machine credential of the simulator's party port, at least 32 characters. Needed only with the simulator
# profile on; the simulator refuses to start without it.
SIMULATOR_PARTY_API_KEY=
# One password for certs/signing.pfx and certs/encryption.pfx.
IDENTITY_CERTIFICATE_PASSWORD=
# EODHD market data API key (worker).
EODHD_API_KEY=
# Lucky Penny license key for MediatR and AutoMapper (webapi), pasted as issued. Empty only logs a
# license warning on start.
LUCKYPENNY_LICENSE_KEY=

# --- First start only ---
# Bootstrap SystemAdmin (identity-auth amendment 2026-11-12). Remove both values after the first
# sign-in to Back Office and run `docker compose up -d webapi` (§12 step 11).
BOOTSTRAP_SYSTEMADMIN_EMAIL=
# Must pass the Identity password options, including one non-alphanumeric character: use `-`.
BOOTSTRAP_SYSTEMADMIN_PASSWORD=

# --- Simulator ---
# `simulator` runs the simulator container (sim.<DOMAIN>); leave empty to keep it off across deploys.
COMPOSE_PROFILES=
# Bootstrap SimulatorOperator (docs/features/simulator.md R9). Remove both values after the first sign-in to
# the simulator and run `docker compose up -d webapi`.
BOOTSTRAP_SIMULATOROPERATOR_EMAIL=
# Must pass the Identity password options, including one non-alphanumeric character: use `-`.
BOOTSTRAP_SIMULATOROPERATOR_PASSWORD=
