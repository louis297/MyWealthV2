# Template for /opt/mywealth/.env on the VPS (docs/deployment.md §5, §6).
# Copy to .env, fill in, `chmod 600 .env`. Keep a copy in the owner's password manager.
# Values: letters and digits only. `$` triggers compose interpolation; quotes or `;` break the
# SQL connection string. GitHub does not hold these values.

# --- Written by deploy.sh. Leave empty on the first start. ---
# Image tag (commit SHA) currently deployed.
IMAGE_TAG=
# Image tag deployed before IMAGE_TAG; used by rollback.sh.
PREVIOUS_IMAGE_TAG=

# --- Server ---
# GitHub owner of the GHCR images, lower case (ghcr.io/<owner>/mywealth-*).
GHCR_OWNER=
# Showcase domain. Hostnames: id., adviser., customer., admin.<DOMAIN>.
DOMAIN=
# Contact email for the ACME account.
ACME_EMAIL=
# Empty for the production ACME issuer. For a first start set it to
# https://acme-staging-v02.api.letsencrypt.org/directory (§12 step 10).
ACME_CA=

# --- Secrets ---
# SQL Server sa password. SQL Server requires 8+ characters with upper case, lower case and digits.
SQL_SA_PASSWORD=
# OIDC client secrets. Each is shared by identity and the matching client host.
ADVISER_PORTAL_CLIENT_SECRET=
CUSTOMER_PORTAL_CLIENT_SECRET=
BACK_OFFICE_CLIENT_SECRET=
# One password for certs/signing.pfx and certs/encryption.pfx.
IDENTITY_CERTIFICATE_PASSWORD=
# EODHD market data API key (worker).
EODHD_API_KEY=

# --- First start only ---
# Bootstrap SystemAdmin (identity-auth amendment 2026-11-12). Remove both values after the first
# sign-in to Back Office and run `docker compose up -d webapi` (§12 step 11).
BOOTSTRAP_SYSTEMADMIN_EMAIL=
BOOTSTRAP_SYSTEMADMIN_PASSWORD=
