# Routing, TLS, rate limits and HSTS for the four public hostnames (docs/deployment.md §3, §11).
# Caddy is the only public entry. It forwards to port 8080 of each host only; the health port 8081
# is never forwarded. reverse_proxy keeps the original Host and sets X-Forwarded-Proto/-For,
# which the hosts trust from 172.30.0.0/24 only.
#
# Hosts reach id.{$DOMAIN} through Caddy on the internal network (compose alias), so the global
# limit skips 172.30.0.0/24; otherwise every host-to-host call from one container shares one key.
# The gateway 172.30.0.1 stays limited: Docker's userland proxy (IPv6 clients, Docker Desktop)
# forwards published-port traffic from that address. The subnet must match compose.yml
# (docs/known-issues/deploy-fixed-docker-subnet.md).
#
# DOMAIN, ACME_EMAIL and ACME_CA come from the container environment (compose.yml, .env).

{
	email {$ACME_EMAIL}
	acme_ca {$ACME_CA}
	order rate_limit before basic_auth
}

(public) {
	header Strict-Transport-Security "max-age=31536000"
	encode zstd gzip

	# Loose global limit per client IP on every hostname.
	rate_limit {
		zone global {
			match {
				expression `!remote_ip('172.30.0.0/24') || remote_ip('172.30.0.1/32')`
			}
			key {remote_host}
			events 300
			window 1m
		}
	}
}

id.{$DOMAIN} {
	import public

	# Hosted login, per client IP. /login* also catches /login/, which ASP.NET routing still serves
	# to the login page. /connect/token is not limited here: every client is confidential and there
	# is no password grant (identity-auth amendment 2026-11-13, lockout).
	rate_limit {
		zone sign_in {
			match {
				method POST
				path /login*
			}
			key {remote_host}
			events 10
			window 1m
		}
	}

	reverse_proxy identity:8080
}

adviser.{$DOMAIN} {
	import public
	reverse_proxy bff-adviser-portal:8080
}

customer.{$DOMAIN} {
	import public
	reverse_proxy bff-customer-portal:8080
}

admin.{$DOMAIN} {
	import public
	reverse_proxy back-office:8080
}
