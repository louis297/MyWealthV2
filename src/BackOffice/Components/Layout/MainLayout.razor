@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6">Back Office</MudText>
        <MudSpacer />
        <form method="post" action="/sign-out" class="bo-sign-out">
            <AntiforgeryToken />
            <button type="submit">Sign out</button>
        </form>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Variant="DrawerVariant.Responsive">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
            <MudNavLink Href="/tenants" Icon="@Icons.Material.Filled.Apartment">Tenants</MudNavLink>
            <MudNavLink Href="/reports" Icon="@Icons.Material.Filled.Assessment">Reports</MudNavLink>
            <MudNavLink Href="/tenant-admins" Icon="@Icons.Material.Filled.ManageAccounts">Tenant admins</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1B4F72",
            AppbarBackground = "#1B4F72",
            Background = "#F4F6F8",
            DrawerBackground = "#FFFFFF"
        }
    };

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
