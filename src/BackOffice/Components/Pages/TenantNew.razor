@page "/tenants/new"
@inject IPlatformApi Api
@inject NavigationManager Navigation

<PageTitle>New tenant</PageTitle>
<h1>New tenant</h1>

@if (error is not null)
{
    <p>@error</p>
}

<EditForm Model="form" OnValidSubmit="Create" FormName="new-tenant">
    <label>Name <InputText @bind-Value="form.Name" /></label>
    <label>Code <InputText @bind-Value="form.Code" /></label>
    <label>Reporting currency
        <InputSelect @bind-Value="form.ReportingCurrency">
            @foreach (var currency in currencies)
            {
                <option value="@currency.Code">@currency.Code</option>
            }
        </InputSelect>
    </label>
    <button type="submit">Create</button>
</EditForm>

@code {
    private readonly FormModel form = new();
    private IReadOnlyList<CurrencyItem> currencies = [];
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        currencies = await Api.ListCurrenciesAsync();
        form.ReportingCurrency = currencies.FirstOrDefault()?.Code ?? "";
    }

    private async Task Create()
    {
        try
        {
            var id = await Api.CreateTenantAsync(form.Name, form.Code, form.ReportingCurrency);
            Navigation.NavigateTo($"/tenants/{id}");
        }
        catch (PlatformApiException exception)
        {
            error = exception.Message;
        }
    }

    private sealed class FormModel
    {
        public string Name { get; set; } = "";
        public string Code { get; set; } = "";
        public string ReportingCurrency { get; set; } = "";
    }
}
