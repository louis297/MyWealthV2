@page "/instruments/{Id:guid}"
@inject IPlatformApi Api

<PageTitle>Instrument</PageTitle>

@if (error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@error</MudAlert>
}

@if (item is not null)
{
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <div>
            <MudText Typo="Typo.h4">@item.Symbol</MudText>
            @if (item.MarketDataConnection is { } connection)
            {
                <MudText Typo="Typo.caption">@($"Prices from {connection}")</MudText>
            }
        </div>
        <MudChip T="string" Color="@(item.IsActive ? Color.Success : Color.Default)">@(item.IsActive ? "Active" : "Disabled")</MudChip>
    </MudStack>

    <MudPaper Class="pa-4 mb-4" Outlined="true">
        <MudStack Spacing="3" Style="max-width: 28rem;">
            <div>
                <MudText Typo="Typo.caption">Quote currency</MudText>
                <MudText Typo="Typo.body1">@item.QuoteCurrency</MudText>
            </div>
            <div>
                <MudText Typo="Typo.caption">Tenant</MudText>
                <MudLink Href="@($"/tenants/{item.TenantId}")">@item.TenantId</MudLink>
            </div>
            <EditForm Model="form" OnValidSubmit="Save" FormName="edit-instrument">
                <MudStack Spacing="3">
                    <MudTextField @bind-Value="form.Symbol" Label="Symbol" Variant="Variant.Outlined" />
                    <MudTextField @bind-Value="form.Name" Label="Name" Variant="Variant.Outlined" />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Save</MudButton>
                </MudStack>
            </EditForm>
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-2">Tax attributes</MudText>
        <MudStack Spacing="3">
            <MudAutocomplete T="string" Label="Issuer country" Variant="Variant.Outlined" Style="max-width: 28rem;"
                             @bind-Value="tax.IssuerCountry" SearchFunc="SearchCountries" Clearable="true"
                             ToStringFunc="@(code => FifTreatmentChoice.CountryLabel(code, countries))"
                             Error="@(TaxError("IssuerCountry") is not null)" ErrorText="@TaxError("IssuerCountry")" />
            <MudText Typo="Typo.subtitle2">FIF treatment</MudText>
            @if (tax.Lines.Count == 0)
            {
                <MudText Typo="Typo.body2">@FifTreatmentChoice.NotClassified</MudText>
            }
            @for (var index = 0; index < tax.Lines.Count; index++)
            {
                var position = index;
                var line = tax.Lines[position];
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap">
                    <MudNumericField T="int?" @bind-Value="line.TaxYear" Label="Tax year" Variant="Variant.Outlined" HideSpinButtons="true"
                                     Style="max-width: 9rem;"
                                     Error="@(TaxError($"FifTreatments[{position}].TaxYear") is not null)"
                                     ErrorText="@TaxError($"FifTreatments[{position}].TaxYear")" />
                    <MudSelect T="string" @bind-Value="line.Treatment" Label="Treatment" Variant="Variant.Outlined" Style="min-width: 18rem;"
                               ToStringFunc="FifTreatmentChoice.Label"
                               Error="@(TaxError($"FifTreatments[{position}].Treatment") is not null)"
                               ErrorText="@TaxError($"FifTreatments[{position}].Treatment")">
                        @foreach (var value in FifTreatmentChoice.Values)
                        {
                            <MudSelectItem T="string" Value="@value">@FifTreatmentChoice.Label(value)</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField T="string" @bind-Value="line.Note" Label="Note" Variant="Variant.Outlined" Style="min-width: 18rem;"
                                  Error="@(TaxError($"FifTreatments[{position}].Note") is not null)"
                                  ErrorText="@TaxError($"FifTreatments[{position}].Note")" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" aria-label="Remove tax year" title="Remove tax year"
                                   OnClick="@(() => RemoveLine(position))" />
                </MudStack>
            }
            @if (TaxError("FifTreatments") is { } linesError)
            {
                <MudText Typo="Typo.body2" Color="Color.Error">@linesError</MudText>
            }
            <MudText Typo="Typo.caption">@FifTreatmentChoice.Explanation</MudText>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Outlined" OnClick="AddLine">Add tax year</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveTaxAttributes">Save tax attributes</MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>

    @if (item.IsActive)
    {
        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="Disable">Disable</MudButton>
    }
    else
    {
        <MudButton Variant="Variant.Outlined" Color="Color.Success" OnClick="Enable">Enable</MudButton>
    }
}

@code {
    private const string ConflictMessage = "This instrument changed. Reload the page.";

    [Parameter]
    public Guid Id { get; set; }

    private InstrumentItem? item;
    private readonly FormModel form = new();
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            countries = await Api.ListCountriesAsync();
            await Reload();
        }
        catch (PlatformApiException exception)
        {
            error = exception.Message;
        }
    }

    private async Task Save()
    {
        if (item is null)
        {
            return;
        }

        try
        {
            await Api.UpdateInstrumentAsync(Id, form.Symbol, form.Name, item.RowVersion);
            await Reload();
            error = null;
        }
        catch (PlatformApiException exception)
        {
            await ShowFailureAsync(exception);
        }
    }

    private async Task Disable()
    {
        if (item is null)
        {
            return;
        }

        try
        {
            await Api.DisableInstrumentAsync(Id, item.RowVersion);
            await Reload();
            error = null;
        }
        catch (PlatformApiException exception)
        {
            await ShowFailureAsync(exception);
        }
    }

    private async Task Enable()
    {
        if (item is null)
        {
            return;
        }

        try
        {
            await Api.EnableInstrumentAsync(Id, item.RowVersion);
            await Reload();
            error = null;
        }
        catch (PlatformApiException exception)
        {
            await ShowFailureAsync(exception);
        }
    }

    private async Task ShowFailureAsync(PlatformApiException exception)
    {
        if (exception.Status != 409)
        {
            error = exception.Message;
            return;
        }

        error = ConflictMessage;
        try
        {
            await Reload();
        }
        catch (PlatformApiException reload)
        {
            error = reload.Message;
        }
    }

    private async Task Reload()
    {
        item = await Api.GetInstrumentAsync(Id);
        form.Symbol = item.Symbol;
        form.Name = item.Name;
        tax.IssuerCountry = item.IssuerCountry;
        tax.Lines.Clear();
        foreach (var row in (item.FifTreatments ?? []).OrderBy(row => row.TaxYear))
        {
            tax.Lines.Add(new TaxLine { TaxYear = row.TaxYear, Treatment = row.Treatment, Note = row.Note });
        }
    }

    private IReadOnlyList<CountryItem> countries = [];
    private readonly TaxForm tax = new();
    private IReadOnlyDictionary<string, string> taxErrors = new Dictionary<string, string>();

    private string? TaxError(string field) => taxErrors.GetValueOrDefault(field);

    private Task<IEnumerable<string>> SearchCountries(string? text, CancellationToken cancellationToken)
    {
        var query = text?.Trim() ?? "";
        var matches = countries
            .Where(country => query.Length == 0
                              || country.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
                              || country.Code.Equals(query, StringComparison.OrdinalIgnoreCase))
            .Select(country => country.Code);
        return Task.FromResult(matches);
    }

    private void AddLine() => tax.Lines.Add(new TaxLine());

    private void RemoveLine(int index)
    {
        if (index >= 0 && index < tax.Lines.Count)
        {
            tax.Lines.RemoveAt(index);
        }
    }

    private async Task SaveTaxAttributes()
    {
        if (item is null)
        {
            return;
        }

        try
        {
            await Api.SetInstrumentTaxAttributesAsync(
                Id,
                string.IsNullOrWhiteSpace(tax.IssuerCountry) ? null : tax.IssuerCountry,
                tax.Lines.Select(line => new FifTreatmentItem(line.TaxYear ?? 0, line.Treatment ?? "", line.Note)).ToList(),
                item.RowVersion);
            await Reload();
            taxErrors = new Dictionary<string, string>();
            error = null;
        }
        catch (PlatformApiException exception)
        {
            taxErrors = ValidationErrors.From(exception);
            if (taxErrors.Count > 0 && exception.Status == 400)
            {
                error = null;
                return;
            }

            await ShowFailureAsync(exception);
        }
    }

    private sealed class TaxForm
    {
        public string? IssuerCountry { get; set; }

        public List<TaxLine> Lines { get; } = [];
    }

    private sealed class TaxLine
    {
        public int? TaxYear { get; set; }

        public string? Treatment { get; set; }

        public string? Note { get; set; }
    }

    private sealed class FormModel
    {
        public string Symbol { get; set; } = "";
        public string Name { get; set; } = "";
    }
}
