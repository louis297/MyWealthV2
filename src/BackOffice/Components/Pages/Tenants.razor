@page "/tenants"
@inject IPlatformApi Api
@inject NavigationManager Navigation

<PageTitle>Tenants</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Tenants</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/tenants/new">New tenant</MudButton>
</MudStack>

<MudPaper Class="pa-4 mb-4" Outlined="true">
    <EditForm Model="filter" OnSubmit="ApplyFilter" FormName="tenant-filter">
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="3" AlignItems="AlignItems.Center">
            <MudTextField T="string" @bind-Value="filter.Search" Label="Search" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Style="min-width: 14rem;" />
            <MudSelect T="string" @bind-Value="filter.Status" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense" ToStringFunc="StatusLabel" Style="min-width: 10rem;">
                <MudSelectItem T="string" Value="@("all")">All</MudSelectItem>
                <MudSelectItem T="string" Value="@("true")">Active</MudSelectItem>
                <MudSelectItem T="string" Value="@("false")">Disabled</MudSelectItem>
            </MudSelect>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Filter</MudButton>
        </MudStack>
    </EditForm>
</MudPaper>

@if (error is not null)
{
    <MudAlert Severity="Severity.Error">@error</MudAlert>
}
else if (list is not null)
{
    <MudTable Items="list.Items" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" Elevation="1">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Code</MudTh>
            <MudTh>Currency</MudTh>
            <MudTh>Active</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name"><MudLink Href="@($"/tenants/{context.Id}")">@context.Name</MudLink></MudTd>
            <MudTd DataLabel="Code">@context.Code</MudTd>
            <MudTd DataLabel="Currency">@context.ReportingCurrency</MudTd>
            <MudTd DataLabel="Active">
                <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">@(context.IsActive ? "Active" : "Disabled")</MudChip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No tenants.</MudText>
        </NoRecordsContent>
    </MudTable>
    <MudText Typo="Typo.body2" Class="mt-3">@(list.TotalCount) tenants</MudText>
}

@code {
    [SupplyParameterFromQuery(Name = "search")]
    public string? Search { get; set; }

    [SupplyParameterFromQuery(Name = "isEnabled")]
    public string? IsEnabled { get; set; }

    private readonly FilterModel filter = new();
    private TenantPage? list;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        filter.Search = Search ?? "";
        filter.Status = IsEnabled is "true" or "false" ? IsEnabled : "all";
        error = null;
        try
        {
            bool? enabled = bool.TryParse(IsEnabled, out var parsed) ? parsed : null;
            list = await Api.ListTenantsAsync(1, 20, enabled, Search);
        }
        catch (PlatformApiException exception)
        {
            error = exception.Message;
        }
    }

    private void ApplyFilter() =>
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["search"] = string.IsNullOrWhiteSpace(filter.Search) ? null : filter.Search.Trim(),
            ["isEnabled"] = filter.Status == "all" ? null : filter.Status
        }));

    private static string StatusLabel(string? value) => value switch
    {
        "true" => "Active",
        "false" => "Disabled",
        _ => "All"
    };

    private sealed class FilterModel
    {
        public string Search { get; set; } = "";
        public string Status { get; set; } = "all";
    }
}
