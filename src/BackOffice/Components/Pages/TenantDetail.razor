@page "/tenants/{Id:guid}"
@inject IPlatformApi Api

<PageTitle>Tenant</PageTitle>

@if (error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@error</MudAlert>
}

@if (item is not null)
{
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
        <MudText Typo="Typo.h4">@item.Name</MudText>
        <MudChip T="string" Color="@(item.IsActive ? Color.Success : Color.Default)">@(item.IsActive ? "Active" : "Disabled")</MudChip>
    </MudStack>
    <MudStack Row="true" Spacing="2" Class="mb-4">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="@($"/tenants/{Id}/config")">Configuration</MudButton>
        <MudButton Variant="Variant.Outlined" Href="@($"/tenant-admins?tenantId={Id}")">Tenant admins</MudButton>
    </MudStack>

    <MudPaper Class="pa-4 mb-4" Outlined="true">
        <MudStack Spacing="3" Style="max-width: 28rem;">
            <div>
                <MudText Typo="Typo.caption">Code</MudText>
                <MudText Typo="Typo.body1">@item.Code</MudText>
            </div>
            <div>
                <MudText Typo="Typo.caption">Allowed custody modes</MudText>
                <MudText Typo="Typo.body1">@string.Join(", ", item.AllowedCustodyModes)</MudText>
            </div>
            <div>
                <MudText Typo="Typo.caption">Broker connection</MudText>
                <MudText Typo="Typo.body1">@BrokerConnectionChoice.Label(item.BrokerConnection)</MudText>
            </div>
            <EditForm Model="form" OnValidSubmit="Save" FormName="edit-tenant">
                <MudStack Spacing="3">
                    <MudTextField @bind-Value="form.Name" Label="Name" Variant="Variant.Outlined" />
                    <MudSelect T="string" @bind-Value="form.ReportingCurrency" Label="Reporting currency" Variant="Variant.Outlined">
                        @foreach (var currency in currencies)
                        {
                            <MudSelectItem T="string" Value="@currency.Code">@currency.Code</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="string" @bind-Value="form.BrokerConnection" Label="Broker connection" Variant="Variant.Outlined"
                               ToStringFunc="BrokerConnectionChoice.Label" Error="@(brokerError is not null)" ErrorText="@brokerError">
                        @foreach (var option in brokerOptions)
                        {
                            <MudSelectItem T="string" Value="@option">@BrokerConnectionChoice.Label(option)</MudSelectItem>
                        }
                    </MudSelect>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle2">Custody modes</MudText>
                        <MudCheckBox T="bool" @bind-Value="custody.AllowsExternal" Label="External accounts"
                                     UserAttributes="@(new Dictionary<string, object?> { ["data-custody-mode"] = CustodyModeChoice.External })" />
                        <MudCheckBox T="bool" @bind-Value="custody.AllowsCustodial" Label="Custodial accounts"
                                     UserAttributes="@(new Dictionary<string, object?> { ["data-custody-mode"] = CustodyModeChoice.Custodial })" />
                        <MudText Typo="Typo.caption">Changing this affects only new accounts.</MudText>
                    </MudStack>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!custody.CanSubmit)">Save</MudButton>
                </MudStack>
            </EditForm>
        </MudStack>
    </MudPaper>

    @if (item.IsActive)
    {
        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="Disable">Disable</MudButton>
    }
    else
    {
        <MudButton Variant="Variant.Outlined" Color="Color.Success" OnClick="Enable">Enable</MudButton>
    }
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private TenantItem? item;
    private IReadOnlyList<CurrencyItem> currencies = [];
    private readonly FormModel form = new();
    private CustodyModeChoice custody = CustodyModeChoice.Both();
    private IReadOnlyList<string> brokerOptions = [];
    private string? error;
    private string? brokerError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            item = await Api.GetTenantAsync(Id);
            currencies = await Api.ListCurrenciesAsync();
            form.Name = item.Name;
            form.ReportingCurrency = item.ReportingCurrency;
            custody = CustodyModeChoice.From(item.AllowedCustodyModes);
            // BO26: the configured broker connections; no "None" on edit.
            form.BrokerConnection = item.BrokerConnection ?? BrokerConnectionChoice.None;
            brokerOptions = BrokerConnectionChoice.Options(await Api.ListBrokerConnectionsAsync(), create: false, item.BrokerConnection);
        }
        catch (PlatformApiException exception)
        {
            error = exception.Message;
        }
    }

    private async Task Save()
    {
        if (item is null || !custody.CanSubmit)
        {
            return;
        }

        try
        {
            await Api.UpdateTenantAsync(
                Id, form.Name, form.ReportingCurrency, custody.ToList(), item.RowVersion, BrokerConnectionChoice.ToBody(form.BrokerConnection));
            item = await Api.GetTenantAsync(Id);
            error = null;
            brokerError = null;
        }
        catch (PlatformApiException exception)
        {
            // BO26: an unknown broker connection is shown at its field.
            brokerError = ValidationErrors.From(exception).GetValueOrDefault("BrokerConnection");
            error = exception.Status == 409
                ? "This tenant changed. Reload the page."
                : brokerError is null ? exception.Message : null;
        }
    }

    private async Task Disable()
    {
        if (item is null)
        {
            return;
        }

        await Api.DisableTenantAsync(Id, item.RowVersion);
        item = await Api.GetTenantAsync(Id);
    }

    private async Task Enable()
    {
        if (item is null)
        {
            return;
        }

        await Api.EnableTenantAsync(Id, item.RowVersion);
        item = await Api.GetTenantAsync(Id);
    }

    private sealed class FormModel
    {
        public string Name { get; set; } = "";
        public string ReportingCurrency { get; set; } = "";
        public string BrokerConnection { get; set; } = BrokerConnectionChoice.None;
    }
}
