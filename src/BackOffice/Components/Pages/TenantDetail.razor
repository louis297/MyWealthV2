@page "/tenants/{Id:guid}"
@inject IPlatformApi Api

<PageTitle>Tenant</PageTitle>

@if (error is not null)
{
    <p>@error</p>
}

@if (item is not null)
{
    <h1>@item.Name</h1>
    <p>Code: <span>@item.Code</span></p>
    <p>Active: @(item.IsActive ? "Active" : "Disabled")</p>
    <p><a href="@($"/tenants/{Id}/config")">Configuration</a></p>
    <p><a href="@($"/tenant-admins?tenantId={Id}")">Tenant admins</a></p>

    <EditForm Model="form" OnValidSubmit="Save" FormName="edit-tenant">
        <label>Name <InputText @bind-Value="form.Name" /></label>
        <label>Reporting currency
            <InputSelect @bind-Value="form.ReportingCurrency">
                @foreach (var currency in currencies)
                {
                    <option value="@currency.Code">@currency.Code</option>
                }
            </InputSelect>
        </label>
        <button type="submit">Save</button>
    </EditForm>

    @if (item.IsActive)
    {
        <button type="button" @onclick="Disable">Disable</button>
    }
    else
    {
        <button type="button" @onclick="Enable">Enable</button>
    }
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private TenantItem? item;
    private IReadOnlyList<CurrencyItem> currencies = [];
    private readonly FormModel form = new();
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            item = await Api.GetTenantAsync(Id);
            currencies = await Api.ListCurrenciesAsync();
            form.Name = item.Name;
            form.ReportingCurrency = item.ReportingCurrency;
        }
        catch (PlatformApiException exception)
        {
            error = exception.Message;
        }
    }

    private async Task Save()
    {
        if (item is null)
        {
            return;
        }

        try
        {
            await Api.UpdateTenantAsync(Id, form.Name, form.ReportingCurrency, item.RowVersion);
            item = await Api.GetTenantAsync(Id);
            error = null;
        }
        catch (PlatformApiException exception)
        {
            error = exception.Status == 409
                ? "This tenant changed. Reload the page."
                : exception.Message;
        }
    }

    private async Task Disable()
    {
        if (item is null)
        {
            return;
        }

        await Api.DisableTenantAsync(Id, item.RowVersion);
        item = await Api.GetTenantAsync(Id);
    }

    private async Task Enable()
    {
        if (item is null)
        {
            return;
        }

        await Api.EnableTenantAsync(Id, item.RowVersion);
        item = await Api.GetTenantAsync(Id);
    }

    private sealed class FormModel
    {
        public string Name { get; set; } = "";
        public string ReportingCurrency { get; set; } = "";
    }
}
