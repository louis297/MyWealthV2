@page "/tenant-admins"
@inject IPlatformApi Api
@inject NavigationManager Navigation

<PageTitle>Tenant admins</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Tenant admins</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/tenant-admins/new">New tenant admin</MudButton>
</MudStack>

<MudPaper Class="pa-4 mb-4" Outlined="true">
    <EditForm Model="filter" OnSubmit="ApplyFilter" FormName="tenant-admin-filter">
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="3" AlignItems="AlignItems.Center">
            <MudSelect T="string" @bind-Value="filter.TenantId" Label="Tenant" Variant="Variant.Outlined" Margin="Margin.Dense" ToStringFunc="TenantLabel" Style="min-width: 16rem;">
                <MudSelectItem T="string" Value="@("all")">All tenants</MudSelectItem>
                @foreach (var tenant in tenants)
                {
                    <MudSelectItem T="string" Value="@tenant.Id.ToString()">@tenant.Name</MudSelectItem>
                }
            </MudSelect>
            <MudTextField T="string" @bind-Value="filter.Search" Label="Search" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Style="min-width: 14rem;" />
            <MudSelect T="string" @bind-Value="filter.Status" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense" ToStringFunc="StatusLabel" Style="min-width: 10rem;">
                <MudSelectItem T="string" Value="@("all")">All</MudSelectItem>
                <MudSelectItem T="string" Value="@("true")">Active</MudSelectItem>
            </MudSelect>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Filter</MudButton>
        </MudStack>
    </EditForm>
</MudPaper>

@if (error is not null)
{
    <MudAlert Severity="Severity.Error">@error</MudAlert>
}
else if (list is not null)
{
    <MudTable Items="list.Items" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" Elevation="1">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Active</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name"><MudLink Href="@($"/tenant-admins/{context.Id}")">@context.Name</MudLink></MudTd>
            <MudTd DataLabel="Email">@context.Email</MudTd>
            <MudTd DataLabel="Status">@context.Status</MudTd>
            <MudTd DataLabel="Active">
                <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">@(context.IsActive ? "Active" : "Disabled")</MudChip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No tenant admins.</MudText>
        </NoRecordsContent>
    </MudTable>
    <MudText Typo="Typo.body2" Class="mt-3">@(list.TotalCount) tenant admins</MudText>
}

@code {
    [SupplyParameterFromQuery(Name = "tenantId")]
    public string? TenantId { get; set; }

    [SupplyParameterFromQuery(Name = "search")]
    public string? Search { get; set; }

    [SupplyParameterFromQuery(Name = "enabledOnly")]
    public string? EnabledOnly { get; set; }

    private readonly FilterModel filter = new();
    private IReadOnlyList<TenantItem>? tenantsLoaded;
    private IReadOnlyList<TenantItem> tenants => tenantsLoaded ?? [];
    private TenantAdminPage? list;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        Guid? tenant = Guid.TryParse(TenantId, out var parsed) ? parsed : null;
        bool? enabled = bool.TryParse(EnabledOnly, out var flag) ? flag : null;
        filter.TenantId = tenant?.ToString() ?? "all";
        filter.Search = Search ?? "";
        filter.Status = enabled is true ? "true" : "all";
        error = null;
        try
        {
            tenantsLoaded ??= (await Api.ListTenantsAsync(1, 100, null, null)).Items;
            list = await Api.ListTenantAdminsAsync(1, 20, tenant, enabled, Search);
        }
        catch (PlatformApiException exception)
        {
            error = exception.Message;
        }
    }

    private void ApplyFilter() =>
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["tenantId"] = filter.TenantId == "all" ? null : filter.TenantId,
            ["search"] = string.IsNullOrWhiteSpace(filter.Search) ? null : filter.Search.Trim(),
            ["enabledOnly"] = filter.Status == "all" ? null : filter.Status
        }));

    private string TenantLabel(string? value) =>
        value == "all"
            ? "All tenants"
            : tenants.FirstOrDefault(tenant => tenant.Id.ToString() == value)?.Name ?? "";

    private static string StatusLabel(string? value) => value == "true" ? "Active" : "All";

    private sealed class FilterModel
    {
        public string TenantId { get; set; } = "all";
        public string Search { get; set; } = "";
        public string Status { get; set; } = "all";
    }
}
