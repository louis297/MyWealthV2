@page "/tenant-admins/new"
@inject IPlatformApi Api
@inject NavigationManager Navigation

<PageTitle>New tenant admin</PageTitle>
<h1>New tenant admin</h1>

@if (error is not null)
{
    <p>@error</p>
}

<EditForm Model="form" OnValidSubmit="Create" FormName="new-tenant-admin">
    <label>Tenant <InputText @bind-Value="form.TenantId" /></label>
    <label>Name <InputText @bind-Value="form.Name" /></label>
    <label>Email <InputText @bind-Value="form.Email" /></label>
    <label>Password <InputText type="password" @bind-Value="form.Password" /></label>
    <button type="submit">Create</button>
</EditForm>

@code {
    [SupplyParameterFromQuery(Name = "tenantId")]
    public string? TenantQuery { get; set; }

    private readonly FormModel form = new();
    private string? error;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(TenantQuery))
        {
            form.TenantId = TenantQuery;
        }
    }

    private async Task Create()
    {
        if (!Guid.TryParse(form.TenantId, out var tenantId))
        {
            error = "Tenant must be a PublicId.";
            return;
        }

        try
        {
            var id = await Api.CreateTenantAdminAsync(tenantId, form.Name, form.Email, form.Password);
            Navigation.NavigateTo($"/tenant-admins/{id}");
        }
        catch (PlatformApiException exception)
        {
            error = exception.Message;
        }
    }

    private sealed class FormModel
    {
        public string TenantId { get; set; } = "";
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
