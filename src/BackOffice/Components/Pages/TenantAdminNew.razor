@page "/tenant-admins/new"
@inject IPlatformApi Api
@inject NavigationManager Navigation

<PageTitle>New tenant admin</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">New tenant admin</MudText>

@if (error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@error</MudAlert>
}

<MudPaper Class="pa-4" Outlined="true">
    <EditForm Model="form" OnValidSubmit="Create" FormName="new-tenant-admin">
        <MudStack Spacing="3" Style="max-width: 28rem;">
            <label>Tenant
                <select @bind="form.TenantId">
                    @foreach (var tenant in tenants)
                    {
                        <option value="@tenant.Id">@tenant.Name</option>
                    }
                </select>
            </label>
            <MudTextField @bind-Value="form.Name" Label="Name" Variant="Variant.Outlined" />
            <MudTextField @bind-Value="form.Email" Label="Email" Variant="Variant.Outlined" />
            <MudTextField @bind-Value="form.Password" Label="Password" InputType="InputType.Password" Variant="Variant.Outlined" />
            <MudStack Row="true" Spacing="2">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Create</MudButton>
                <MudButton Variant="Variant.Text" Href="/tenant-admins">Cancel</MudButton>
            </MudStack>
        </MudStack>
    </EditForm>
</MudPaper>

@code {
    [SupplyParameterFromQuery(Name = "tenantId")]
    public string? TenantQuery { get; set; }

    private readonly FormModel form = new();
    private IReadOnlyList<TenantItem> tenants = [];
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var tenantPage = await Api.ListTenantsAsync(1, 100, true, null);
            tenants = tenantPage.Items;
        }
        catch (PlatformApiException exception)
        {
            error = exception.Message;
            return;
        }

        var requested = Guid.TryParse(TenantQuery, out var parsed)
            ? tenants.FirstOrDefault(tenant => tenant.Id == parsed)
            : null;
        form.TenantId = (requested ?? tenants.FirstOrDefault())?.Id.ToString() ?? "";
    }

    private async Task Create()
    {
        if (!Guid.TryParse(form.TenantId, out var tenantId) || tenants.All(tenant => tenant.Id != tenantId))
        {
            error = "Choose an active tenant.";
            return;
        }

        try
        {
            var id = await Api.CreateTenantAdminAsync(tenantId, form.Name, form.Email, form.Password);
            Navigation.NavigateTo($"/tenant-admins/{id}");
        }
        catch (PlatformApiException exception)
        {
            error = exception.Message;
        }
    }

    private sealed class FormModel
    {
        public string TenantId { get; set; } = "";
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
