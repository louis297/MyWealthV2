@page "/instruments"
@inject IPlatformApi Api
@inject NavigationManager Navigation

<PageTitle>Instruments</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Instruments</MudText>
    @if (selectedTenant is not null)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@($"/instruments/new?tenantId={selectedTenant.Id}")">New instrument</MudButton>
    }
</MudStack>

<MudPaper Class="pa-4 mb-4" Outlined="true">
    <EditForm Model="filter" OnSubmit="ApplyFilter" FormName="instrument-filter">
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="3" AlignItems="AlignItems.Center">
            <MudSelect T="string" @bind-Value="filter.TenantId" Label="Tenant" Variant="Variant.Outlined" Margin="Margin.Dense" ToStringFunc="TenantLabel" Placeholder="Choose a tenant" Style="min-width: 16rem;">
                @foreach (var tenant in tenants)
                {
                    <MudSelectItem T="string" Value="@tenant.Id.ToString()">@tenant.Name</MudSelectItem>
                }
            </MudSelect>
            <MudTextField T="string" @bind-Value="filter.Search" Label="Search" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Style="min-width: 14rem;" />
            <MudSelect T="string" @bind-Value="filter.Status" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense" ToStringFunc="StatusLabel" Style="min-width: 10rem;">
                <MudSelectItem T="string" Value="@("all")">All</MudSelectItem>
                <MudSelectItem T="string" Value="@("true")">Active</MudSelectItem>
            </MudSelect>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Filter</MudButton>
        </MudStack>
    </EditForm>
</MudPaper>

@if (prompt)
{
    <MudAlert Severity="Severity.Info">Choose a tenant</MudAlert>
}
else if (error is not null)
{
    <MudAlert Severity="Severity.Error">@error</MudAlert>
}
else if (list is not null)
{
    @if (list.Items.Count == 0)
    {
        <MudText>No instruments</MudText>
    }
    else
    {
        <MudTable Items="list.Items" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" Elevation="1">
            <HeaderContent>
                <MudTh>Symbol</MudTh>
                <MudTh>Name</MudTh>
                <MudTh>Quote currency</MudTh>
                <MudTh>Active</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Symbol"><MudLink Href="@($"/instruments/{context.Id}")">@context.Symbol</MudLink></MudTd>
                <MudTd DataLabel="Name">@context.Name</MudTd>
                <MudTd DataLabel="Quote currency">@context.QuoteCurrency</MudTd>
                <MudTd DataLabel="Active">@(context.IsActive ? "Active" : "Disabled")</MudTd>
                <MudTd DataLabel="Open"><MudLink Href="@($"/instruments/{context.Id}")">Open</MudLink></MudTd>
            </RowTemplate>
        </MudTable>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "tenantId")]
    public string? TenantId { get; set; }

    [SupplyParameterFromQuery(Name = "search")]
    public string? Search { get; set; }

    [SupplyParameterFromQuery(Name = "enabledOnly")]
    public string? EnabledOnly { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? PageNumber { get; set; }

    [SupplyParameterFromQuery(Name = "pageSize")]
    public int? PageSize { get; set; }

    private readonly FilterModel filter = new();
    private IReadOnlyList<TenantItem>? tenantsLoaded;
    private IReadOnlyList<TenantItem> tenants => tenantsLoaded ?? [];
    private TenantItem? selectedTenant;
    private InstrumentPage? list;
    private string? error;
    private bool prompt;

    protected override async Task OnParametersSetAsync()
    {
        bool? enabled = bool.TryParse(EnabledOnly, out var parsed) ? parsed : null;
        filter.Search = Search ?? "";
        filter.Status = enabled is true ? "true" : "all";
        filter.TenantId = null;
        selectedTenant = null;
        list = null;
        error = null;
        prompt = false;

        try
        {
            tenantsLoaded ??= (await Api.ListTenantsAsync(1, 100, true, null)).Items;
        }
        catch (PlatformApiException exception)
        {
            error = exception.Message;
            return;
        }

        if (!Guid.TryParse(TenantId, out var tenantId))
        {
            prompt = true;
            return;
        }

        filter.TenantId = tenantId.ToString();
        selectedTenant = tenants.FirstOrDefault(tenant => tenant.Id == tenantId);
        var page = PageNumber is >= 1 ? PageNumber.Value : 1;
        var pageSize = PageSize is null ? 20 : Math.Clamp(PageSize.Value, 1, 100);
        try
        {
            list = await Api.ListInstrumentsAsync(page, pageSize, tenantId, enabled, Search);
        }
        catch (PlatformApiException exception)
        {
            error = exception.Message;
        }
    }

    private void ApplyFilter() =>
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["tenantId"] = filter.TenantId,
            ["search"] = string.IsNullOrWhiteSpace(filter.Search) ? null : filter.Search.Trim(),
            ["enabledOnly"] = filter.Status == "all" ? null : filter.Status,
            ["page"] = null
        }));

    private string TenantLabel(string? value) =>
        tenants.FirstOrDefault(tenant => tenant.Id.ToString() == value)?.Name ?? "";

    private static string StatusLabel(string? value) => value == "true" ? "Active" : "All";

    private sealed class FilterModel
    {
        public string? TenantId { get; set; }
        public string Search { get; set; } = "";
        public string Status { get; set; } = "all";
    }
}
