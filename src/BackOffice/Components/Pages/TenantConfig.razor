@page "/tenants/{TenantId:guid}/config"
@inject IPlatformApi Api

<PageTitle>Tenant configuration</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">Configuration</MudText>
<MudLink Href="@($"/tenants/{TenantId}")" Class="mb-4">Back to tenant</MudLink>

@if (error is not null)
{
    <MudAlert Severity="Severity.Error" Class="my-4">@error</MudAlert>
}

@if (reports.Count == 0)
{
    <MudText Class="mt-4">No reports.</MudText>
}
else
{
    <MudSimpleTable Hover="true" Dense="true" Bordered="true" Class="mt-4">
        <thead>
            <tr><th>Code</th><th>Name</th><th>Scope</th><th>Grant state</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var report in reports.Where(report => report.IsActive))
        {
            <tr>
                <td>@report.Code</td>
                <td>@report.Name</td>
                <td>@report.Scope</td>
                <td>@(report.Granted ? "Granted" : "Not granted")</td>
                <td>
                    @if (report.Granted)
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" OnClick="() => Disable(report.Id)">Disable</MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Success" OnClick="() => Enable(report.Id)">Enable</MudButton>
                    }
                </td>
            </tr>
        }
        </tbody>
    </MudSimpleTable>
}

<MudText Typo="Typo.h5" Class="mt-8 mb-2">Client money accounts</MudText>

@if (clientMoneyAccounts.Count == 0)
{
    <MudText>No client money accounts.</MudText>
}
else
{
    <MudSimpleTable Hover="true" Dense="true" Bordered="true" Class="mt-2">
        <thead>
            <tr><th>Currency</th><th>Bank</th><th>Account name</th><th>Account number</th><th>Connection</th><th>Statement</th><th>Active</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var row in clientMoneyAccounts)
        {
            <tr>
                <td>@row.Currency</td>
                <td>@row.BankName</td>
                <td>@row.AccountName</td>
                <td>@row.AccountNumber</td>
                <td>@row.BankConnection</td>
                <td>@FeedStatus.Text(row.BankFeed)</td>
                <td>@(row.IsActive ? "Yes" : "No")</td>
                <td>
                    @if (row.IsActive)
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" data-client-money-account="@row.Id" OnClick="() => DisableClientMoneyAccount(row)">Disable</MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Success" data-client-money-account="@row.Id" OnClick="() => EnableClientMoneyAccount(row)">Enable</MudButton>
                    }
                </td>
            </tr>
        }
        </tbody>
    </MudSimpleTable>
}

<MudText Typo="Typo.body2" Class="mt-2">Details cannot be changed. To correct them, disable the account and add a new one. Disabling the last account in a currency stops new Custodial accounts in that currency.</MudText>

<MudText Typo="Typo.h6" Class="mt-6 mb-2">Add client money account</MudText>
<MudPaper Class="pa-4" Outlined="true">
    <EditForm Model="newAccount" OnValidSubmit="AddClientMoneyAccount" FormName="new-client-money-account">
        <MudStack Spacing="3" Style="max-width: 28rem;">
            <MudSelect T="string" @bind-Value="newAccount.Currency" Label="Currency" Variant="Variant.Outlined"
                       Error="@HasFieldError("Currency")" ErrorText="@FieldError("Currency")">
                @foreach (var currency in currencies)
                {
                    <MudSelectItem T="string" Value="@currency.Code">@currency.Code</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="newAccount.BankName" Label="Bank name" Variant="Variant.Outlined"
                          Error="@HasFieldError("BankName")" ErrorText="@FieldError("BankName")" />
            <MudTextField @bind-Value="newAccount.AccountName" Label="Account name" Variant="Variant.Outlined"
                          Error="@HasFieldError("AccountName")" ErrorText="@FieldError("AccountName")" />
            <MudTextField @bind-Value="newAccount.AccountNumber" Label="Account number" Variant="Variant.Outlined"
                          Error="@HasFieldError("AccountNumber")" ErrorText="@FieldError("AccountNumber")" />
            @if (bankConnections.Count == 0)
            {
                <MudText Color="Color.Warning">No bank connection is configured.</MudText>
            }
            else
            {
                <MudSelect T="string" @bind-Value="newAccount.BankConnection" Label="Bank connection" Variant="Variant.Outlined"
                           Error="@HasFieldError("BankConnection")" ErrorText="@FieldError("BankConnection")">
                    @foreach (var connection in bankConnections)
                    {
                        <MudSelectItem T="string" Value="@connection.Name">@connection.Name</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudStack Row="true" Spacing="2">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                           Disabled="@(bankConnections.Count == 0)">Add</MudButton>
            </MudStack>
        </MudStack>
    </EditForm>
</MudPaper>

<MudText Typo="Typo.h5" Class="mt-8 mb-2">Safekeeping accounts</MudText>

@if (safekeepingAccounts.Count == 0)
{
    <MudText>No safekeeping accounts. Holdings of this firm are not checked against a custodian.</MudText>
}
else
{
    <MudSimpleTable Hover="true" Dense="true" Bordered="true" Class="mt-2">
        <thead>
            <tr><th>Currency</th><th>Custodian</th><th>Account name</th><th>Account number</th><th>Connection</th><th>Feed</th><th>Positions as at</th><th>Active</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var row in safekeepingAccounts)
        {
            <tr>
                <td>@row.Currency</td>
                <td>@row.CustodianName</td>
                <td>@row.AccountName</td>
                <td>@row.AccountNumber</td>
                <td>@row.CustodianConnection</td>
                <td>@CustodianText.Feed(row.CustodianFeed)</td>
                <td>@CustodianText.PositionsAt(row.CustodianFeed)</td>
                <td>@(row.IsActive ? "Yes" : "No")</td>
                <td>
                    @if (row.IsActive)
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" data-safekeeping-account="@row.Id" OnClick="() => DisableSafekeepingAccount(row)">Disable</MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Success" data-safekeeping-account="@row.Id" OnClick="() => EnableSafekeepingAccount(row)">Enable</MudButton>
                    }
                </td>
            </tr>
        }
        </tbody>
    </MudSimpleTable>
}

<MudText Typo="Typo.h6" Class="mt-6 mb-2">Add safekeeping account</MudText>
<MudPaper Class="pa-4" Outlined="true">
    <EditForm Model="newSafekeeping" OnValidSubmit="AddSafekeepingAccount" FormName="new-safekeeping-account">
        <MudStack Spacing="3" Style="max-width: 28rem;">
            <MudSelect T="string" @bind-Value="newSafekeeping.Currency" Label="Currency" Variant="Variant.Outlined"
                       Error="@HasSafekeepingError("Currency")" ErrorText="@SafekeepingError("Currency")">
                @foreach (var currency in currencies)
                {
                    <MudSelectItem T="string" Value="@currency.Code">@currency.Code</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="newSafekeeping.CustodianName" Label="Custodian name" Variant="Variant.Outlined"
                          Error="@HasSafekeepingError("CustodianName")" ErrorText="@SafekeepingError("CustodianName")" />
            <MudTextField @bind-Value="newSafekeeping.AccountName" Label="Account name" Variant="Variant.Outlined"
                          Error="@HasSafekeepingError("AccountName")" ErrorText="@SafekeepingError("AccountName")" />
            <MudTextField @bind-Value="newSafekeeping.AccountNumber" Label="Account number" Variant="Variant.Outlined"
                          Error="@HasSafekeepingError("AccountNumber")" ErrorText="@SafekeepingError("AccountNumber")" />
            @if (custodianConnections.Count == 0)
            {
                <MudText Color="Color.Warning">No custodian connection is configured.</MudText>
            }
            else
            {
                <MudSelect T="string" @bind-Value="newSafekeeping.CustodianConnection" Label="Custodian connection" Variant="Variant.Outlined"
                           Error="@HasSafekeepingError("CustodianConnection")" ErrorText="@SafekeepingError("CustodianConnection")">
                    @foreach (var connection in custodianConnections)
                    {
                        <MudSelectItem T="string" Value="@connection.Name">@connection.Name</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudStack Row="true" Spacing="2">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                           Disabled="@(custodianConnections.Count == 0)">Add safekeeping account</MudButton>
            </MudStack>
        </MudStack>
    </EditForm>
</MudPaper>

<MudText Typo="Typo.h5" Class="mt-8 mb-2">Interest runs</MudText>

@if (interestRuns.Count == 0)
{
    <MudText>No interest runs yet.</MudText>
}
else
{
    <MudSimpleTable Hover="true" Dense="true" Bordered="true" Class="mt-2">
        <thead>
            <tr><th>As of</th><th>Trigger</th><th>Accounts</th><th>Failed</th><th>Posted</th><th>Interest paid</th><th>Tax withheld</th></tr>
        </thead>
        <tbody>
        @foreach (var run in interestRuns)
        {
            <tr>
                <td>@run.AsOfDate.ToString("yyyy-MM-dd")</td>
                <td>@TriggerLabel(run.Trigger)</td>
                <td>@run.AccountsProcessed</td>
                <td>@run.AccountsFailed</td>
                <td>@run.PostingCount</td>
                <td>@Totals(run, total => total.GrossAmount)</td>
                <td>@Totals(run, total => total.TaxAmount)</td>
            </tr>
        }
        </tbody>
    </MudSimpleTable>
}

<MudText Typo="Typo.h6" Class="mt-6 mb-2">Run for a date</MudText>
<MudPaper Class="pa-4" Outlined="true">
    <EditForm Model="runForm" OnValidSubmit="StartInterestRun" FormName="interest-run">
        <MudStack Spacing="3" Style="max-width: 28rem;">
            <MudTextField T="string" @bind-Value="runForm.AsOfDate" Label="As of date (UTC)" Variant="Variant.Outlined" InputType="InputType.Date"
                          Error="@HasFieldError("AsOfDate")" ErrorText="@FieldError("AsOfDate")" />
            <MudStack Row="true" Spacing="2">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Run</MudButton>
            </MudStack>
            <MudText Typo="Typo.body2">Runs every day by itself. Use this after a missed run. A run for a day already done changes nothing.</MudText>
        </MudStack>
    </EditForm>
</MudPaper>

@code {
    [Parameter]
    public Guid TenantId { get; set; }

    private IReadOnlyList<ReportGrantItem> reports = [];
    private IReadOnlyList<ClientMoneyAccountItem> clientMoneyAccounts = [];
    private IReadOnlyList<CurrencyItem> currencies = [];
    private IReadOnlyList<BankConnectionItem> bankConnections = [];
    private IReadOnlyDictionary<string, string> fieldErrors = new Dictionary<string, string>();
    private readonly ClientMoneyAccountForm newAccount = new();
    private IReadOnlyList<InterestRunItem> interestRuns = [];
    private IReadOnlyList<SafekeepingAccountItem> safekeepingAccounts = [];
    private IReadOnlyList<CustodianConnectionItem> custodianConnections = [];
    private IReadOnlyDictionary<string, string> safekeepingErrors = new Dictionary<string, string>();
    private readonly SafekeepingAccountForm newSafekeeping = new();
    private readonly InterestRunForm runForm = new();
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await Load();
        try
        {
            currencies = await Api.ListCurrenciesAsync();
            newAccount.Currency = currencies.FirstOrDefault()?.Code ?? "";
            bankConnections = await Api.ListBankConnectionsAsync();
            newAccount.BankConnection = bankConnections.Count == 1 ? bankConnections[0].Name : "";
            newSafekeeping.Currency = newAccount.Currency;
            custodianConnections = await Api.ListCustodianConnectionsAsync();
            newSafekeeping.CustodianConnection = custodianConnections.Count == 1 ? custodianConnections[0].Name : "";
        }
        catch (PlatformApiException exception)
        {
            error = exception.Message;
        }
    }

    private async Task Load()
    {
        try
        {
            reports = await Api.ListReportGrantsAsync(TenantId);
            clientMoneyAccounts = await Api.ListClientMoneyAccountsAsync(TenantId);
            interestRuns = await Api.ListInterestRunsAsync(TenantId);
            safekeepingAccounts = await Api.ListSafekeepingAccountsAsync(TenantId);
            error = null;
        }
        catch (PlatformApiException exception)
        {
            error = exception.Message;
        }
    }

    private async Task Enable(Guid reportId)
    {
        try
        {
            await Api.GrantReportAsync(TenantId, reportId);
            await Load();
        }
        catch (PlatformApiException exception)
        {
            error = exception.Message;
        }
    }

    private async Task Disable(Guid reportId)
    {
        try
        {
            await Api.RevokeReportAsync(TenantId, reportId);
            await Load();
        }
        catch (PlatformApiException exception)
        {
            error = exception.Message;
        }
    }

    private bool HasFieldError(string field) => fieldErrors.ContainsKey(field);

    private string? FieldError(string field) => fieldErrors.GetValueOrDefault(field);

    private async Task AddClientMoneyAccount()
    {
        try
        {
            await Api.CreateClientMoneyAccountAsync(
                TenantId, newAccount.Currency, newAccount.BankName, newAccount.AccountName, newAccount.AccountNumber, newAccount.BankConnection);
            fieldErrors = new Dictionary<string, string>();
            newAccount.BankName = "";
            newAccount.AccountName = "";
            newAccount.AccountNumber = "";
            await Load();
        }
        catch (PlatformApiException exception)
        {
            fieldErrors = ValidationErrors.From(exception);
            error = fieldErrors.Count == 0 ? exception.Message : null;
        }
    }

    private async Task DisableClientMoneyAccount(ClientMoneyAccountItem row)
    {
        try
        {
            await Api.DisableClientMoneyAccountAsync(TenantId, row.Id, row.RowVersion);
            await Load();
        }
        catch (PlatformApiException exception)
        {
            error = exception.Message;
        }
    }

    private async Task EnableClientMoneyAccount(ClientMoneyAccountItem row)
    {
        try
        {
            await Api.EnableClientMoneyAccountAsync(TenantId, row.Id, row.RowVersion);
            await Load();
        }
        catch (PlatformApiException exception)
        {
            error = ValidationErrors.From(exception).Values.FirstOrDefault() ?? exception.Message;
        }
    }

    private bool HasSafekeepingError(string field) => safekeepingErrors.ContainsKey(field);

    private string? SafekeepingError(string field) => safekeepingErrors.GetValueOrDefault(field);

    /// <summary>In-kind transfers BO30: a 400 (a second active account in the currency, a number in use) is shown at its field.</summary>
    private async Task AddSafekeepingAccount()
    {
        try
        {
            await Api.CreateSafekeepingAccountAsync(
                TenantId, newSafekeeping.Currency, newSafekeeping.CustodianName, newSafekeeping.AccountName, newSafekeeping.AccountNumber,
                newSafekeeping.CustodianConnection);
            safekeepingErrors = new Dictionary<string, string>();
            newSafekeeping.CustodianName = "";
            newSafekeeping.AccountName = "";
            newSafekeeping.AccountNumber = "";
            await Load();
        }
        catch (PlatformApiException exception)
        {
            safekeepingErrors = ValidationErrors.From(exception);
            error = safekeepingErrors.Count == 0 ? exception.Message : null;
        }
    }

    private async Task DisableSafekeepingAccount(SafekeepingAccountItem row)
    {
        try
        {
            await Api.DisableSafekeepingAccountAsync(TenantId, row.Id, row.RowVersion);
            await Load();
        }
        catch (PlatformApiException exception)
        {
            error = ValidationErrors.From(exception).Values.FirstOrDefault() ?? exception.Message;
        }
    }

    private async Task EnableSafekeepingAccount(SafekeepingAccountItem row)
    {
        try
        {
            await Api.EnableSafekeepingAccountAsync(TenantId, row.Id, row.RowVersion);
            await Load();
        }
        catch (PlatformApiException exception)
        {
            error = ValidationErrors.From(exception).Values.FirstOrDefault() ?? exception.Message;
        }
    }

    /// <summary>BO21: runs interest for the as-of date at once; a 400 at AsOfDate is shown at the date.</summary>
    private async Task StartInterestRun()
    {
        if (!DateOnly.TryParse(runForm.AsOfDate, System.Globalization.CultureInfo.InvariantCulture, out var asOfDate))
        {
            fieldErrors = new Dictionary<string, string> { ["AsOfDate"] = "Enter a date." };
            return;
        }

        try
        {
            await Api.StartInterestRunAsync(TenantId, asOfDate);
            fieldErrors = new Dictionary<string, string>();
            await Load();
        }
        catch (PlatformApiException exception)
        {
            fieldErrors = ValidationErrors.From(exception);
            error = fieldErrors.Count == 0 ? exception.Message : null;
        }
    }

    /// <summary>BO20: the trigger words of interest-run D60.</summary>
    private static string TriggerLabel(string trigger) => trigger switch
    {
        "Scheduled" => "Daily run",
        "Manual" => "Run by the platform team",
        "AccountClosure" => "Account closure",
        _ => trigger
    };

    private static string Totals(InterestRunItem run, Func<InterestRunTotal, decimal> amount) =>
        string.Join(", ", run.Totals.Select(total =>
            $"{amount(total).ToString("0.00##", System.Globalization.CultureInfo.InvariantCulture)} {total.Currency}"));

    private sealed class InterestRunForm
    {
        public string AsOfDate { get; set; } = DateOnly.FromDateTime(DateTime.UtcNow).AddDays(-1).ToString("yyyy-MM-dd");
    }

    private sealed class SafekeepingAccountForm
    {
        public string Currency { get; set; } = "";
        public string CustodianName { get; set; } = "";
        public string AccountName { get; set; } = "";
        public string AccountNumber { get; set; } = "";
        public string CustodianConnection { get; set; } = "";
    }

    private sealed class ClientMoneyAccountForm
    {
        public string Currency { get; set; } = "";
        public string BankName { get; set; } = "";
        public string AccountName { get; set; } = "";
        public string AccountNumber { get; set; } = "";
        public string BankConnection { get; set; } = "";
    }
}
