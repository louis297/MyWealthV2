@page "/tenants/{TenantId:guid}/config"
@inject IPlatformApi Api

<PageTitle>Tenant configuration</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">Configuration</MudText>
<MudLink Href="@($"/tenants/{TenantId}")" Class="mb-4">Back to tenant</MudLink>

@if (error is not null)
{
    <MudAlert Severity="Severity.Error" Class="my-4">@error</MudAlert>
}

@if (reports.Count == 0)
{
    <MudText Class="mt-4">No reports.</MudText>
}
else
{
    <MudSimpleTable Hover="true" Dense="true" Bordered="true" Class="mt-4">
        <thead>
            <tr><th>Code</th><th>Name</th><th>Scope</th><th>Grant state</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var report in reports.Where(report => report.IsActive))
        {
            <tr>
                <td>@report.Code</td>
                <td>@report.Name</td>
                <td>@report.Scope</td>
                <td>@(report.Granted ? "Granted" : "Not granted")</td>
                <td>
                    @if (report.Granted)
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" OnClick="() => Disable(report.Id)">Disable</MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Success" OnClick="() => Enable(report.Id)">Enable</MudButton>
                    }
                </td>
            </tr>
        }
        </tbody>
    </MudSimpleTable>
}

<MudText Typo="Typo.h5" Class="mt-8 mb-2">Client money accounts</MudText>

@if (clientMoneyAccounts.Count == 0)
{
    <MudText>No client money accounts.</MudText>
}
else
{
    <MudSimpleTable Hover="true" Dense="true" Bordered="true" Class="mt-2">
        <thead>
            <tr><th>Currency</th><th>Bank</th><th>Account name</th><th>Account number</th><th>Connection</th><th>Statement</th><th>Active</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var row in clientMoneyAccounts)
        {
            <tr>
                <td>@row.Currency</td>
                <td>@row.BankName</td>
                <td>@row.AccountName</td>
                <td>@row.AccountNumber</td>
                <td>@row.BankConnection</td>
                <td>@FeedStatus.Text(row.BankFeed)</td>
                <td>@(row.IsActive ? "Yes" : "No")</td>
                <td>
                    @if (row.IsActive)
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" data-client-money-account="@row.Id" OnClick="() => DisableClientMoneyAccount(row)">Disable</MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Success" data-client-money-account="@row.Id" OnClick="() => EnableClientMoneyAccount(row)">Enable</MudButton>
                    }
                </td>
            </tr>
        }
        </tbody>
    </MudSimpleTable>
}

<MudText Typo="Typo.body2" Class="mt-2">Details cannot be changed. To correct them, disable the account and add a new one. Disabling the last account in a currency stops new Custodial accounts in that currency.</MudText>

<MudText Typo="Typo.h6" Class="mt-6 mb-2">Add client money account</MudText>
<MudPaper Class="pa-4" Outlined="true">
    <EditForm Model="newAccount" OnValidSubmit="AddClientMoneyAccount" FormName="new-client-money-account">
        <MudStack Spacing="3" Style="max-width: 28rem;">
            <MudSelect T="string" @bind-Value="newAccount.Currency" Label="Currency" Variant="Variant.Outlined"
                       Error="@HasFieldError("Currency")" ErrorText="@FieldError("Currency")">
                @foreach (var currency in currencies)
                {
                    <MudSelectItem T="string" Value="@currency.Code">@currency.Code</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="newAccount.BankName" Label="Bank name" Variant="Variant.Outlined"
                          Error="@HasFieldError("BankName")" ErrorText="@FieldError("BankName")" />
            <MudTextField @bind-Value="newAccount.AccountName" Label="Account name" Variant="Variant.Outlined"
                          Error="@HasFieldError("AccountName")" ErrorText="@FieldError("AccountName")" />
            <MudTextField @bind-Value="newAccount.AccountNumber" Label="Account number" Variant="Variant.Outlined"
                          Error="@HasFieldError("AccountNumber")" ErrorText="@FieldError("AccountNumber")" />
            @if (bankConnections.Count == 0)
            {
                <MudText Color="Color.Warning">No bank connection is configured.</MudText>
            }
            else
            {
                <MudSelect T="string" @bind-Value="newAccount.BankConnection" Label="Bank connection" Variant="Variant.Outlined"
                           Error="@HasFieldError("BankConnection")" ErrorText="@FieldError("BankConnection")">
                    @foreach (var connection in bankConnections)
                    {
                        <MudSelectItem T="string" Value="@connection.Name">@connection.Name</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudStack Row="true" Spacing="2">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                           Disabled="@(bankConnections.Count == 0)">Add</MudButton>
            </MudStack>
        </MudStack>
    </EditForm>
</MudPaper>

@code {
    [Parameter]
    public Guid TenantId { get; set; }

    private IReadOnlyList<ReportGrantItem> reports = [];
    private IReadOnlyList<ClientMoneyAccountItem> clientMoneyAccounts = [];
    private IReadOnlyList<CurrencyItem> currencies = [];
    private IReadOnlyList<BankConnectionItem> bankConnections = [];
    private IReadOnlyDictionary<string, string> fieldErrors = new Dictionary<string, string>();
    private readonly ClientMoneyAccountForm newAccount = new();
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await Load();
        try
        {
            currencies = await Api.ListCurrenciesAsync();
            newAccount.Currency = currencies.FirstOrDefault()?.Code ?? "";
            bankConnections = await Api.ListBankConnectionsAsync();
            newAccount.BankConnection = bankConnections.Count == 1 ? bankConnections[0].Name : "";
        }
        catch (PlatformApiException exception)
        {
            error = exception.Message;
        }
    }

    private async Task Load()
    {
        try
        {
            reports = await Api.ListReportGrantsAsync(TenantId);
            clientMoneyAccounts = await Api.ListClientMoneyAccountsAsync(TenantId);
            error = null;
        }
        catch (PlatformApiException exception)
        {
            error = exception.Message;
        }
    }

    private async Task Enable(Guid reportId)
    {
        try
        {
            await Api.GrantReportAsync(TenantId, reportId);
            await Load();
        }
        catch (PlatformApiException exception)
        {
            error = exception.Message;
        }
    }

    private async Task Disable(Guid reportId)
    {
        try
        {
            await Api.RevokeReportAsync(TenantId, reportId);
            await Load();
        }
        catch (PlatformApiException exception)
        {
            error = exception.Message;
        }
    }

    private bool HasFieldError(string field) => fieldErrors.ContainsKey(field);

    private string? FieldError(string field) => fieldErrors.GetValueOrDefault(field);

    private async Task AddClientMoneyAccount()
    {
        try
        {
            await Api.CreateClientMoneyAccountAsync(
                TenantId, newAccount.Currency, newAccount.BankName, newAccount.AccountName, newAccount.AccountNumber, newAccount.BankConnection);
            fieldErrors = new Dictionary<string, string>();
            newAccount.BankName = "";
            newAccount.AccountName = "";
            newAccount.AccountNumber = "";
            await Load();
        }
        catch (PlatformApiException exception)
        {
            fieldErrors = ValidationErrors.From(exception);
            error = fieldErrors.Count == 0 ? exception.Message : null;
        }
    }

    private async Task DisableClientMoneyAccount(ClientMoneyAccountItem row)
    {
        try
        {
            await Api.DisableClientMoneyAccountAsync(TenantId, row.Id, row.RowVersion);
            await Load();
        }
        catch (PlatformApiException exception)
        {
            error = exception.Message;
        }
    }

    private async Task EnableClientMoneyAccount(ClientMoneyAccountItem row)
    {
        try
        {
            await Api.EnableClientMoneyAccountAsync(TenantId, row.Id, row.RowVersion);
            await Load();
        }
        catch (PlatformApiException exception)
        {
            error = ValidationErrors.From(exception).Values.FirstOrDefault() ?? exception.Message;
        }
    }

    private sealed class ClientMoneyAccountForm
    {
        public string Currency { get; set; } = "";
        public string BankName { get; set; } = "";
        public string AccountName { get; set; } = "";
        public string AccountNumber { get; set; } = "";
        public string BankConnection { get; set; } = "";
    }
}
