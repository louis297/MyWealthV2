@page "/tenants/{TenantId:guid}/config"
@inject IPlatformApi Api

<PageTitle>Tenant configuration</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">Configuration</MudText>
<MudLink Href="@($"/tenants/{TenantId}")" Class="mb-4">Back to tenant</MudLink>

@if (error is not null)
{
    <MudAlert Severity="Severity.Error" Class="my-4">@error</MudAlert>
}

@if (reports.Count == 0)
{
    <MudText Class="mt-4">No reports.</MudText>
}
else
{
    <MudSimpleTable Hover="true" Dense="true" Bordered="true" Class="mt-4">
        <thead>
            <tr><th>Code</th><th>Name</th><th>Scope</th><th>Grant state</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var report in reports.Where(report => report.IsActive))
        {
            <tr>
                <td>@report.Code</td>
                <td>@report.Name</td>
                <td>@report.Scope</td>
                <td>@(report.Granted ? "Granted" : "Not granted")</td>
                <td>
                    @if (report.Granted)
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" OnClick="() => Disable(report.Id)">Disable</MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Success" OnClick="() => Enable(report.Id)">Enable</MudButton>
                    }
                </td>
            </tr>
        }
        </tbody>
    </MudSimpleTable>
}

@code {
    [Parameter]
    public Guid TenantId { get; set; }

    private IReadOnlyList<ReportGrantItem> reports = [];
    private string? error;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        try
        {
            reports = await Api.ListReportGrantsAsync(TenantId);
            error = null;
        }
        catch (PlatformApiException exception)
        {
            error = exception.Message;
        }
    }

    private async Task Enable(Guid reportId)
    {
        try
        {
            await Api.GrantReportAsync(TenantId, reportId);
            await Load();
        }
        catch (PlatformApiException exception)
        {
            error = exception.Message;
        }
    }

    private async Task Disable(Guid reportId)
    {
        try
        {
            await Api.RevokeReportAsync(TenantId, reportId);
            await Load();
        }
        catch (PlatformApiException exception)
        {
            error = exception.Message;
        }
    }
}
