@page "/tenants/{TenantId:guid}/config"
@inject IPlatformApi Api

<PageTitle>Tenant configuration</PageTitle>
<h1>Configuration</h1>
<p><a href="@($"/tenants/{TenantId}")">Back to tenant</a></p>

@if (error is not null)
{
    <p>@error</p>
}

@if (reports.Count == 0)
{
    <p>No reports.</p>
}
else
{
    <table>
        <thead>
            <tr><th>Code</th><th>Name</th><th>Scope</th><th>Catalog</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var report in reports)
        {
            <tr>
                <td>@report.Code</td>
                <td>@report.Name</td>
                <td>@report.Scope</td>
                <td>@(report.IsActive ? "Active" : "Inactive")</td>
                <td>
                    @if (report.Granted)
                    {
                        <button type="button" @onclick="() => Disable(report.Id)">Disable</button>
                    }
                    else
                    {
                        <button type="button" @onclick="() => Enable(report.Id)">Enable</button>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    [Parameter]
    public Guid TenantId { get; set; }

    private IReadOnlyList<ReportGrantItem> reports = [];
    private string? error;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        try
        {
            reports = await Api.ListReportGrantsAsync(TenantId);
            error = null;
        }
        catch (PlatformApiException exception)
        {
            error = exception.Message;
        }
    }

    private async Task Enable(Guid reportId)
    {
        try
        {
            await Api.GrantReportAsync(TenantId, reportId);
            await Load();
        }
        catch (PlatformApiException exception)
        {
            error = exception.Message;
        }
    }

    private async Task Disable(Guid reportId)
    {
        try
        {
            await Api.RevokeReportAsync(TenantId, reportId);
            await Load();
        }
        catch (PlatformApiException exception)
        {
            error = exception.Message;
        }
    }
}
